{
  "name": "fitness-checkin-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "微信小程序健身打卡应用 - 基于Taro 3.x + React + TypeScript",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "taro build --type rn --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "KouDouMa <koudouma@fitness-checkin.com>",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@tarojs/components": "3.6.x",
    "@tarojs/helper": "3.6.x",
    "@tarojs/plugin-platform-weapp": "3.6.x",
    "@tarojs/plugin-platform-h5": "3.6.x",
    "@tarojs/react": "3.6.x",
    "@tarojs/runtime": "3.6.x",
    "@tarojs/shared": "3.6.x",
    "@tarojs/taro": "3.6.x",
    "@tarojs/plugin-framework-react": "3.6.x",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "taro-ui": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@tarojs/cli": "3.6.x",
    "@tarojs/webpack5-runner": "3.6.x",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "autoprefixer": "^10.4.14",
    "babel-preset-taro": "3.6.x",
    "css-loader": "3.4.2",
    "postcss": "^8.4.24",
    "postcss-loader": "^4.2.0",
    "sass": "^1.62.1",
    "sass-loader": "^13.3.1",
    "style-loader": "1.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.1.0",
    "webpack": "5.78.0"
  }
}
