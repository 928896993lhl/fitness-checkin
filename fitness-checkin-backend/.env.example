# ==========================================
# 健身打卡小程序 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---- JWT密钥 ----
# 生产环境必须设置为至少32字节的随机字符串
JWT_SECRET=your-256-bit-secret-key-here-change-me

# ---- 数据库配置 ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=fitness_user
DB_PASSWORD=your_database_password_here

# ---- Redis配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 微信小程序配置 ----
# 从微信公众平台获取: https://mp.weixin.qq.com
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ---- Spring Profile ----
# 可选值: dev, prod
SPRING_PROFILES_ACTIVE=prod
